// Install with `hk install --mise` (lychee is mise-managed; mdformat and check-gifs run via uv)

amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

min_hk_version = "1.54.0"

local linters = new Mapping<String, Step> {
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["mdformat"] {
    glob = "*.md"
    check =
      "uvx --with mdformat-footnote --with mdformat-gfm --with mdformat-toc mdformat --check {{files}}"
    fix = "uvx --with mdformat-footnote --with mdformat-gfm --with mdformat-toc mdformat {{files}}"
  }
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["pkl-format"] = Builtins.pkl_format
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

local commit_msg_checks = new Mapping<String, Step> {
  ["check-conventional-commit"] = Builtins.check_conventional_commit
}

// Network-bound, so kept off pre-commit/fix and only run on pre-push/check.
local network_checks = new Mapping<String, Step> {
  ["check-gifs"] {
    glob = "*.md"
    check = "uv run scripts/check_gifs.py {{files}}"
  }
  ["lychee"] {
    glob = "*.md"
    check = "uv run scripts/check_links.py {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps = new { ...network_checks; ...linters }
  }
  ["commit-msg"] {
    steps = commit_msg_checks
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = new { ...network_checks; ...linters }
  }
}
